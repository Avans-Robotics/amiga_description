<?xml version="1.0"?>
<!-- The bare Amiga as a standalone robot. To add the Amiga to your own robot, include amiga.xacro and call the macro. -->
<robot name="amiga" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="prefix" default=""/>
  <xacro:include filename="$(find amiga_description)/urdf/amiga.xacro"/>
  <xacro:amiga prefix="$(arg prefix)"/>
</robot>

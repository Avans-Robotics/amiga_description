<?xml version="1.0"?>
<!-- The bare Amiga as a standalone robot. To add the Amiga to your own robot, include amiga.xacro and call the macro.
     gazebo:=true adds the Gazebo drive and wheel joint states (amiga.gazebo.xacro). -->
<robot name="amiga" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="gazebo" default="false"/>
  <xacro:include filename="$(find amiga_description)/urdf/amiga.xacro"/>
  <xacro:amiga prefix="$(arg prefix)"/>
  <xacro:if value="$(arg gazebo)">
    <xacro:include filename="$(find amiga_description)/urdf/amiga.gazebo.xacro"/>
    <xacro:amiga_gazebo prefix="$(arg prefix)"/>
  </xacro:if>
</robot>
